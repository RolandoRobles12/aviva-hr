# Firebase — copia el Project ID de la consola de Firebase
FIREBASE_PROJECT_ID=aviva-hr-XXXXX

# Ruta al archivo JSON de la cuenta de servicio (solo para desarrollo local)
# En Cloud Run esto no se necesita — usa Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Puerto del servidor (Cloud Run lo inyecta automáticamente)
PORT=8080
